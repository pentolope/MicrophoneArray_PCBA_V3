# Python bytecode from the tools/ generators and checkers
__pycache__/
*.py[cod]

# KiCad local scratch
*-backups/
fp-info-cache

# Validator run output. Regenerated by `run.py validate|build|selftest`;
# never a source of truth, and previously committed by accident.
verification/out/
build/

# Toolkit scratch: one directory per invocation, nothing durable.
out/

# Scenario working directories: deck/result copies the runner rewrites.
benchmark/scenarios/workdir_*/

# Fabrication-check working copies: derived scratch; the DRC verdict JSONs are the evidence.
benchmark/boardB/candidates/*/stages/fabcheck-*/fabcheck.kicad_pcb
benchmark/boardB/candidates/*/stages/fabcheck-*/fabcheck.kicad_prl
benchmark/boardB/candidates/*/stages/fabcheck-*/fabcheck.kicad_pro
benchmark/boardB/candidates/*/workdir_*/
benchmark/boardB/candidates/*/candidate_routed.kicad_pcb.pre-lastmile
